<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>麻雀どうぶつ診断｜あなたは16タイプのどの雀士？</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#efe7d2;--ink:#1d2a24;--felt:#1f5a45;--felt2:#2a7058;--tile:#fbf7ea;--line:#cfc4a3;--red:#b8352b;--mute:#5b655f;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f211a;--ink:#f2ecd9;--felt:#2a7058;--felt2:#358667;--tile:#1a342a;--line:#2f4d40;--red:#e0675c;--mute:#a9b6ae}}
:root[data-theme="dark"]{--bg:#0f211a;--ink:#f2ecd9;--felt:#2a7058;--felt2:#358667;--tile:#1a342a;--line:#2f4d40;--red:#e0675c;--mute:#a9b6ae}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Zen Maru Gothic","Hiragino Maru Gothic ProN","Hiragino Sans","Meiryo",sans-serif;line-height:1.75}
main{max-width:640px;margin:0 auto;padding:28px 18px 56px}
h1{font-size:30px;font-weight:900;margin:0 0 6px;letter-spacing:.02em}
.sub{color:var(--mute);margin:0 0 22px}
.tile{background:var(--tile);border:2px solid var(--line);border-bottom-width:6px;border-radius:14px;padding:20px}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible{outline:3px solid var(--red);outline-offset:2px}
.start{display:block;width:100%;background:var(--felt);color:#fff;border:0;border-bottom:5px solid #123a2c;border-radius:12px;padding:16px;font-size:18px;font-weight:900;margin-top:18px}
.start:active{transform:translateY(2px);border-bottom-width:3px}
.bar{height:8px;background:var(--line);border-radius:4px;overflow:hidden;margin-bottom:6px}
.bar i{display:block;height:100%;background:var(--felt2);transition:width .25s}
.cnt{color:var(--mute);font-size:14px;margin-bottom:14px}
.q{font-size:20px;font-weight:700;margin:0 0 16px}
.sit{font-size:13px;color:var(--mute);margin:0 0 4px}
.opt{display:block;width:100%;text-align:left;background:var(--tile);border:2px solid var(--line);border-bottom-width:5px;border-radius:12px;padding:14px 16px;margin-bottom:12px;font-weight:500}
.opt:hover{border-color:var(--felt2)}.opt:active{transform:translateY(2px);border-bottom-width:3px}
.res{text-align:center}
.res img{width:220px;max-width:70%;height:auto;border-radius:16px;background:#fff}
.code{display:inline-block;background:var(--red);color:#fff;font-weight:900;letter-spacing:.18em;padding:2px 14px;border-radius:6px;margin-top:10px}
.res h2{font-size:34px;margin:8px 0 0;font-weight:900}
.cat{color:var(--felt2);font-weight:700;margin:0 0 12px}
.res p.d{text-align:left;margin:14px 0}
.axes{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0;text-align:left}
.axes div{background:var(--bg);border-radius:8px;padding:8px 10px;font-size:14px}
.axes b{display:block;font-size:13px;color:var(--mute);font-weight:500}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.row button{flex:1;min-width:140px;border:2px solid var(--felt);background:transparent;border-radius:10px;padding:10px;font-weight:700}
.row button.p{background:var(--felt);color:#fff}
h3{margin:34px 0 10px;font-size:18px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.grid button{background:var(--tile);border:2px solid var(--line);border-radius:10px;padding:6px 2px;font-size:12px;line-height:1.3;text-align:center}
.grid img{width:100%;height:auto;border-radius:8px;display:block;background:#fff;margin-bottom:3px}
.grid span{display:block;color:var(--mute);font-size:10px;letter-spacing:.1em}
[hidden]{display:none!important}
@media (max-width:420px){.grid{grid-template-columns:repeat(4,1fr)}h1{font-size:26px}}
.hd{max-width:960px;margin:0 auto}.hd img{display:block;width:100%;height:auto}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
</style>
</head>
<body>
<header class="hd"><img src="data:image/jpeg;base64," alt="麻雀どうぶつ診断 MAHJONG ANIMAL DIAGNOSIS"></header>
<main>
<section id="intro">
<h1 class="sr">麻雀どうぶつ診断</h1>
<p class="sub">15の質問に直感で答えてください。あなたの打ち方に近い動物がわかります。</p>
<div class="tile">
<p style="margin:0">攻めか守りか、打点かスピードか、論理か直感か、自分で完結するか他力を使うか。4つの軸の組み合わせで16タイプに分類します。</p>
<button class="start" id="go">診断をはじめる</button>
</div>
</section>
<section id="quiz" hidden>
<div class="bar"><i id="pb"></i></div>
<div class="cnt" id="cnt"></div>
<p class="sit" id="sit"></p>
<p class="q" id="qt"></p>
<button class="opt" id="oa"></button>
<button class="opt" id="ob"></button>
</section>
<section id="result" hidden></section>
<h3>16タイプ一覧</h3>
<div class="grid" id="grid"></div>
</main>
<script>
const IMG={"APLF": "data:image/jpeg;base64,", "APIM": "data:image/jpeg;base64,", "APIF": "data:image/jpeg;base64,", "DSIF": "data:image/jpeg;base64,", "DSIM": "data:image/jpeg;base64,", "DSLF": "data:image/jpeg;base64,", "DSLM": "data:image/jpeg;base64,", "DPIF": "data:image/jpeg;base64,", "DPIM": "data:image/jpeg;base64,", "DPLF": "data:image/jpeg;base64,", "DPLM": "data:image/jpeg;base64,", "ASIF": "data:image/jpeg;base64,", "ASIM": "data:image/jpeg;base64,", "ASLF": "data:image/jpeg;base64,", "ASLM": "data:image/jpeg;base64,", "APLM": "data:image/jpeg;base64,"};
const QS=[
["投資で少し勝っています。ここからどうする？","リスクを取ってでも、さらに大きな利益を狙いにいく。","確実に利益を残すため、ここでストップして手堅く守る。"],
["対戦ゲームやスポーツの終盤。自分のチームが僅差で勝っている。","点差を広げるために、最後まで攻めの姿勢を崩さない。","逆転されないよう、徹底的に守りを固めて逃げ切る。"],
["仕事や課題に取り組むとき、あなたのスタイルは？","時間がかかってでも、クオリティの高い完璧なものに仕上げる。","多少荒削りでも、とにかく最速で終わらせて提出する。"],
["人気の行列店にランチに来た。","1時間並んででも、最高に美味しいものを食べる。","並ぶのは嫌なので、すぐ隣の空いている普通の店に入る。"],
["人生において重要な決断を迫られたとき、最後に頼るのは？","客観的なデータ、過去の統計、合理的な理由。","「こっちの方が上手くいきそう」という自分の直感やインスピレーション。"],
["じゃんけんやクジ引きで3回連続で負けた。どう思う？","「ただの確率の偏りだ」と割り切り、特に気にしない。","「今日はツイてない」と感じる。"],
["新しいプロジェクトや作業を進めるとき、どう進める？","なるべく自分の力だけで、一から最後まで作り上げたい。","他人の手を借りたり、使えるツールはどんどん活用して効率よく進める。"],
["料理を作ることになった。","事前に決めたレシピ通りに、材料を揃えてじっくり作る。","冷蔵庫にある余り物を見て、その場で臨機応変にメニューを考えて作る。"],
["RPGゲームで、自分より明らかに強い敵がいるエリアを見つけた。","装備が整っていなくても挑んで、大きな報酬を狙う。","しっかりレベルを上げて、安全に戦える状態になってから進む。"],
["家電を買うとき、最後は何で決める？","スペック、口コミ、価格比較などのデータ。","見た目や、「これが好き」という第一印象。"],
["部屋の掃除をすることになった。","時間がかかっても、隅々まで完璧にきれいにする。","目立つところだけ、ざっと手早く終わらせる。"],
["友達とのグループ旅行の計画を任された。","行き先も予定も、自分で調べて一から組み立てる。","みんなの意見やアプリの提案を取り入れて、効率よく決める。"],
["「当たれば賞金が2倍、外れたら0」の勝負に誘われた。","面白そうなので乗る。","割に合わないので乗らない。"],
["家具を買った。組み立てはどうする？","説明書を見ながら、自分一人で最後まで組み立てる。","業者や詳しい人にお願いして、任せてしまう。"],
["旅行先で、行ったことのない道に入る機会があった。","せっかくなので、知らない道や店を開拓する。","外さないように、定番や評判のよい所へ行く。"]];
const QA=[0,0,1,1,2,2,3,3,0,2,1,3,0,3,0];
const AX=[["A","攻め型","D","守り型","リスク許容度"],["P","こだわり重視","S","スピード重視","達成方法"],["L","論理派","I","直感派","決断"],["M","自己完結型","F","他力活用型","進め方"]];
const T={
APLM:["トラ","孤高のハンター","データと計算に基づき、たった一人でリスクを背負ってでも最大の結果（獲物）を狙いに行く完璧主義者。"],
APLF:["シャチ","海の策士","論理的で頭が良く、周囲の環境やツール（他力）をフル活用して、ダイナミックかつ確実に大きな成果を奪い取る。"],
APIM:["ヒグマ","野生の王者","理屈よりも己の直感とパワーを信じる。リスクを恐れず、単独行動で一撃必殺の大勝負に出る。"],
APIF:["ライオン","百獣の王","「今だ！」という直感と野生の勘に優れ、周囲（群れ）の力もうまく巻き込みながら、堂々と大きな獲物を仕留める。"],
ASLM:["チーター","孤高のスプリンター","緻密な計算と無駄のない動きで、誰の力も借りず、一直線に最速で目標を達成する。"],
ASLF:["オオカミ","チームプレーの達人","論理的な戦略を持ち、仲間や便利なツールを駆使して、効率よく最速でタスクを終わらせる。"],
ASIM:["イノシシ","猪突猛進","「いける！」と思ったら直感の赴くまま、リスクを気にせず一人で猛ダッシュする。良くも悪くもブレーキがない。"],
ASIF:["ハイエナ","臨機応変なサバイバー","感覚を頼りに状況を読み、他人の力や周りの環境をちゃっかり利用して、素早く美味しいところを持っていく。"],
DPLM:["フクロウ","賢き森の番人","普段は静かに危険を避け、計算し尽くした完璧なタイミングが来たときだけ、一人で確実に大物を狙う。"],
DPLF:["ゾウ","温厚なる知将","守備力が高く論理的。決して無理はせず、周囲と協力しながら時間をかけてでも着実に大きな成果を組み上げる。"],
DPIM:["ワニ","水際の待ち伏せ名人","直感を信じて気配を消し、ひたすら安全地帯で待つ。そして「ここぞ」という波が来た時だけ己の力で噛み付く。"],
DPIF:["カバ","縄張りの主","普段は温厚で守りを固めているが、感覚的に「チャンスだ」と思った時の爆発力は最強。周りの環境に合わせてどっしり構える。"],
DSLM:["キツネ","狡猾なミニマリスト","危険なことには一切近づかず、論理的な判断で無駄を省き、誰にも頼らずサクッと手堅い成果を上げる。"],
DSLF:["ミーアキャット","警戒心MAXの防衛隊","常に周囲のデータを集めてリスクを回避。周りの人やツールと連携し、絶対に安全な方法で最速でタスクをこなす。"],
DSIM:["ウサギ","逃げ足の天才","「なんだか嫌な予感がする」という直感に優れ、少しでも危険を感じたら一人でサッと安全地帯へ逃げ込む。"],
DSIF:["スズメ","処世術の達人","場の空気を直感で読み取り、目立たず群れに紛れる。危険を避けながら、身の丈にあった小さな成果を素早く積み重ねる。"]};
const $=id=>document.getElementById(id);
let ans=[],i=0;
function show(id){["intro","quiz","result"].forEach(s=>$(s).hidden=s!==id);window.scrollTo(0,0)}
function ask(){const q=QS[i];$("pb").style.width=(i/QS.length*100)+"%";$("cnt").textContent=(i+1)+" / "+QS.length;$("sit").textContent="";$("qt").textContent=q[0];$("oa").textContent="A　"+q[1];$("ob").textContent="B　"+q[2]}
function pick(n){ans.push(n);i++;if(i<QS.length)ask();else finish()}
function finish(){let c="";for(let k=0;k<4;k++){const idx=QA.map((x,n)=>x===k?n:-1).filter(n=>n>=0);const s=idx.filter(n=>ans[n]===0).length;const h=idx.length/2;c+=s>h?AX[k][0]:s<h?AX[k][2]:(ans[idx[0]]===0?AX[k][0]:AX[k][2])}render(c,true)}
function render(c,mine){const t=T[c];let h='<div class="tile res"><img src="'+IMG[c]+'" alt="'+t[0]+'"><br><span class="code">'+c+'</span><h2>'+t[0]+'</h2><p class="cat">'+t[1]+'</p><p class="d">'+t[2]+'</p><div class="axes">';
for(let k=0;k<4;k++){const L=c[k];h+='<div><b>'+AX[k][4]+'</b>'+(L===AX[k][0]?AX[k][1]:AX[k][3])+'</div>'}
h+='</div><div class="row">'+(mine?'<button class="p" id="cp">結果をコピー</button>':'')+'<button id="rt">'+(mine?'もう一度診断する':'診断する')+'</button></div></div>';
$("result").innerHTML=h;show("result");
$("rt").onclick=()=>{ans=[];i=0;show("quiz");ask()};
if(mine)$("cp").onclick=()=>{const s="私の麻雀動物診断は【"+t[0]+"（"+t[1]+"）】でした！ "+location.href.split("#")[0];try{navigator.clipboard.writeText(s);$("cp").textContent="コピーしました"}catch(e){$("cp").textContent="コピーできませんでした"}}}
$("go").onclick=()=>{ans=[];i=0;show("quiz");ask()};
$("oa").onclick=()=>pick(0);$("ob").onclick=()=>pick(1);
$("grid").innerHTML=Object.keys(T).map(c=>'<button data-c="'+c+'"><img src="'+IMG[c]+'" alt="">'+T[c][0]+'<span>'+c+'</span></button>').join("");
$("grid").onclick=e=>{const b=e.target.closest("button");if(b)render(b.dataset.c,false)};
</script>
</body>
</html>
